# Dependencies and build caches (dist/ is intentionally versioned)
node_modules/
/backend/target/
.pnpm-store/
coverage/
.cache/

# Runtime data, workspace exports and backups
/data/
/backups/
/exports/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.bak
