*.jks

# Local agent / hosting metadata and editor settings
.openai/
.codex/
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# Keep machine-specific deployment material local; publish generic examples only
/deploy/*
!/deploy/Caddyfile
!/deploy/callpath.service
!/deploy/nginx.conf
