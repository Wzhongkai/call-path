            "code": [
              {
                "id": "login_l1",
                "text": "async function handleLogin(input) {"
              },
              {
                "id": "login_l2",
                "text": "  const data = validateInput(input);"
              },
              {
                "id": "login_l3",
                "text": "  const user = await findUser(data.email);"
              },
              {
                "id": "login_l4",
                "text": "  const ok = verifyPassword(data, user);"
              },
              {
                "id": "login_l5",
                "text": "  if (!ok) throw Error('认证失败');"
              },
              {
                "id": "login_l6",
                "text": "  const token = createToken(user);"
              },
              {
                "id": "login_l7",
                "text": "  return { user, token };"
              },
              {
                "id": "login_l8",
                "text": "}"
              }
            ],
            "file": "src/auth/login.ts",
            "language": "typescript",
