# Browser origin, without a trailing path. Use your real HTTPS domain in production.
PUBLIC_ORIGIN=http://127.0.0.1:8080
# Set /code when reverse proxying the app at /code/; leave empty for root hosting.
BASE_PATH=
# Prefer creating accounts with the CLI; enable only when public signup is desired.
ALLOW_REGISTRATION=false
# Only for temporary HTTP access on a trusted network; public deployments use HTTPS.
ALLOW_INSECURE_HTTP=false
